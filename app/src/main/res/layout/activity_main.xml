<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="راصد المساحة"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="—"
        android:textColor="#9AA3C7"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/permPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لقراءة مساحة التطبيقات بدقة، فعّل «إتاحة الوصول إلى بيانات الاستخدام» لتطبيق راصد المساحة."
            android:textColor="#E6E9F8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGrant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#7C5CFF"
            android:text="منح الإذن"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTotal"
                style="@style/Chip"
                android:text="الإجمالي" />

            <TextView
                android:id="@+id/chipApp"
                style="@style/Chip"
                android:text="التطبيق" />

            <TextView
                android:id="@+id/chipData"
                style="@style/Chip"
                android:text="البيانات" />

            <TextView
                android:id="@+id/chipCache"
                style="@style/Chip"
                android:text="الكاش" />

            <TextView
                android:id="@+id/chipDir"
                style="@style/Chip"
                android:text="تنازلي ↓" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/chipAll"
            style="@style/Chip"
            android:text="تحديد الكل" />

        <Button
            android:id="@+id/btnClean"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:alpha="0.5"
            android:backgroundTint="#F59E0B"
            android:text="مسح الكاش"
            android:textColor="#1A1442"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
